# ============================================================
# KampStock Frontend — Production Environment Variables
# Copy this to .env.production.local and fill in real values
# ============================================================

# Your Railway backend URL
VITE_API_URL=https://your-backend.railway.app/api

# multi = all roles can log in (cashier, manager, admin, storekeeper)
# single = owner-only mode (no username field shown)
VITE_APP_MODE=multi
