VITE_API_URL=https://kampstock-pzmh.vercel.app/api
VITE_APP_MODE=multi
# Root domain of this deployment. Subdomain extraction is relative to this.
# Set to your custom domain if you add one (e.g. kampstock.app).
# Without this, subdomain-based tenant routing is disabled (single-tenant mode on Vercel).
VITE_APP_DOMAIN=
