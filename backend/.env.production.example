# ============================================================
# KampStock Backend — Production Environment Variables
# Copy this to .env and fill in your real values
# ============================================================

# Supabase PostgreSQL connection (Session Mode - port 5432)
# Found at: Supabase Dashboard > Settings > Database > Connection string > URI
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# JWT Secrets — generate strong random strings (64+ chars)
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="REPLACE_WITH_STRONG_SECRET_MIN_64_CHARS"
JWT_REFRESH_SECRET="REPLACE_WITH_DIFFERENT_STRONG_SECRET_MIN_64_CHARS"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=production

# CORS — your Vercel frontend URL
ALLOWED_ORIGINS="https://your-app.vercel.app"

# Frontend URL (used for Pesapal callback redirect)
FRONTEND_URL="https://your-app.vercel.app"

# ============================================================
# Pesapal Billing Integration
# Get sandbox keys: https://developer.pesapal.com/api3-demo-keys.txt
# Get live keys: https://www.pesapal.com/dashboard/account/register
# ============================================================
PESAPAL_ENV="sandbox"           # "sandbox" or "live"
PESAPAL_CONSUMER_KEY="REPLACE_WITH_PESAPAL_CONSUMER_KEY"
PESAPAL_CONSUMER_SECRET="REPLACE_WITH_PESAPAL_CONSUMER_SECRET"
# IPN URL — publicly accessible endpoint Pesapal will call back on payment
PESAPAL_IPN_URL="https://your-backend.railway.app/api/billing/ipn"
# Where to redirect users after Pesapal payment (frontend billing page)
PESAPAL_CALLBACK_URL="https://your-app.vercel.app/billing/callback"
