# ============================================================
# KampStock Backend — Production Environment Variables
# Copy this to .env and fill in your real values
# ============================================================

# ─── Database (Neon PostgreSQL — Vercel serverless) ────────────────────────────
# Use the Neon POOLER connection string (port 5432 or 6543).
# IMPORTANT: Append ?connection_limit=1&pool_timeout=20&sslmode=require
# This prevents Neon connection exhaustion when Vercel spins up many concurrent
# serverless instances (each with its own Prisma pool).
#
# Without connection_limit=1, Prisma defaults to 10 connections per instance.
# With 10+ concurrent cold starts, 10×10=100+ connections → Neon limit hit.
#
# Example (Neon pooler URL):
DATABASE_URL="postgresql://neondb_owner:[PASSWORD]@[HOST]-pooler.c-[REGION].us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connection_limit=1&pool_timeout=20"

# JWT Secrets — generate strong random strings (64+ chars)
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="REPLACE_WITH_STRONG_SECRET_MIN_64_CHARS"
JWT_REFRESH_SECRET="REPLACE_WITH_DIFFERENT_STRONG_SECRET_MIN_64_CHARS"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=production

# CORS — your Vercel frontend URL (always allowed, no wildcard)
ALLOWED_ORIGINS="https://your-app.vercel.app"

# Frontend URL (used for Pesapal callback redirect and CORS fallback)
FRONTEND_URL="https://your-app.vercel.app"

# Root domain for tenant subdomain routing (e.g. kampstock.app).
# When set, only <sub>.APP_DOMAIN hostnames are treated as tenant subdomains.
# When empty, subdomain routing is disabled — all users log in via the root URL.
# DO NOT set this to a *.vercel.app hostname; Vercel project URLs are never root domains.
APP_DOMAIN=""

# ============================================================
# Pesapal Billing Integration
# Get sandbox keys: https://developer.pesapal.com/api3-demo-keys.txt
# Get live keys: https://www.pesapal.com/dashboard/account/register
# ============================================================
PESAPAL_ENV="sandbox"           # "sandbox" or "live"
PESAPAL_CONSUMER_KEY="REPLACE_WITH_PESAPAL_CONSUMER_KEY"
PESAPAL_CONSUMER_SECRET="REPLACE_WITH_PESAPAL_CONSUMER_SECRET"
# IPN URL — publicly accessible endpoint Pesapal will call back on payment
PESAPAL_IPN_URL="https://your-backend.railway.app/api/billing/ipn"
# Optional: pre-register your IPN with Pesapal once and paste the ipn_id here.
# Setting this avoids duplicate IPN registrations on Vercel cold starts.
# If not set, the service will register automatically on first request.
PESAPAL_IPN_ID=""
# Where to redirect users after Pesapal payment (frontend billing page)
PESAPAL_CALLBACK_URL="https://your-app.vercel.app/billing/callback"
