generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id           Int      @id @default(autoincrement())
    name         String
    username     String   @unique
    passwordHash String   @map("password_hash")
    phone        String?
    roleId       Int      @map("role_id")
    isActive     Boolean  @default(true) @map("is_active")
    createdAt    DateTime @default(now()) @map("created_at")
    updatedAt    DateTime @updatedAt @map("updated_at")

    role           Role            @relation(fields: [roleId], references: [id])
    sales          Sale[]
    expenses       Expense[]
    auditLogs      AuditLog[]
    stockMovements StockMovement[]
    purchaseOrders PurchaseOrder[]
    goodsReceipts  GoodsReceipt[]
    priceHistories PriceHistory[]

    @@map("users")
}

model Role {
    id          Int      @id @default(autoincrement())
    name        String   @unique
    permissions Json     @default("{}")
    createdAt   DateTime @default(now()) @map("created_at")

    users User[]

    @@map("roles")
}

model Category {
    id        Int      @id @default(autoincrement())
    name      String   @unique
    parentId  Int?     @map("parent_id")
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
    children Category[] @relation("CategoryParent")
    products Product[]

    @@map("categories")
}

model Product {
    id              Int      @id @default(autoincrement())
    name            String
    sku             String   @unique
    barcode         String?  @unique
    categoryId      Int      @map("category_id")
    brand           String?
    description     String?
    unitOfMeasure   String   @default("piece") @map("unit_of_measure")
    allowFractional Boolean  @default(false) @map("allow_fractional")
    hasExpiry       Boolean  @default(false) @map("has_expiry")
    defaultTaxRate  Decimal  @default(0) @map("default_tax_rate") @db.Decimal(5, 2)
    isActive        Boolean  @default(true) @map("is_active")
    createdAt       DateTime @default(now()) @map("created_at")
    updatedAt       DateTime @updatedAt @map("updated_at")

    category           Category            @relation(fields: [categoryId], references: [id])
    units              ProductUnit[]
    stockItems         StockItem[]
    stockMovements     StockMovement[]
    saleLines          SaleLine[]
    priceHistories     PriceHistory[]
    purchaseOrderLines PurchaseOrderLine[]
    goodsReceiptLines  GoodsReceiptLine[]

    @@map("products")
}

model ProductUnit {
    id                    Int      @id @default(autoincrement())
    productId             Int      @map("product_id")
    unitName              String   @map("unit_name")
    conversionFactor      Decimal  @default(1) @map("conversion_factor") @db.Decimal(10, 4)
    buyingPrice           Decimal  @default(0) @map("buying_price") @db.Decimal(14, 2)
    sellingPriceRetail    Decimal  @default(0) @map("selling_price_retail") @db.Decimal(14, 2)
    sellingPriceWholesale Decimal  @default(0) @map("selling_price_wholesale") @db.Decimal(14, 2)
    minWholesaleQty       Int      @default(10) @map("min_wholesale_qty")
    createdAt             DateTime @default(now()) @map("created_at")
    updatedAt             DateTime @updatedAt @map("updated_at")

    product Product @relation(fields: [productId], references: [id])

    @@map("product_units")
}

model PriceHistory {
    id          Int      @id @default(autoincrement())
    productId   Int      @map("product_id")
    oldPrice    Decimal  @map("old_price") @db.Decimal(14, 2)
    newPrice    Decimal  @map("new_price") @db.Decimal(14, 2)
    priceType   String   @map("price_type")
    changedById Int      @map("changed_by")
    changedAt   DateTime @default(now()) @map("changed_at")

    product   Product @relation(fields: [productId], references: [id])
    changedBy User    @relation(fields: [changedById], references: [id])

    @@map("price_histories")
}

model StockLocation {
    id          Int      @id @default(autoincrement())
    name        String   @unique
    description String?
    isActive    Boolean  @default(true) @map("is_active")
    createdAt   DateTime @default(now()) @map("created_at")

    stockItems    StockItem[]
    fromMovements StockMovement[] @relation("FromLocation")
    toMovements   StockMovement[] @relation("ToLocation")

    @@map("stock_locations")
}

model StockItem {
    id             Int       @id @default(autoincrement())
    productId      Int       @map("product_id")
    locationId     Int       @map("location_id")
    quantityOnHand Decimal   @default(0) @map("quantity_on_hand") @db.Decimal(14, 4)
    batchNo        String?   @map("batch_no")
    expiryDate     DateTime? @map("expiry_date")
    lastCostPrice  Decimal   @default(0) @map("last_cost_price") @db.Decimal(14, 2)
    updatedAt      DateTime  @updatedAt @map("updated_at")

    product  Product       @relation(fields: [productId], references: [id])
    location StockLocation @relation(fields: [locationId], references: [id])

    @@unique([productId, locationId, batchNo])
    @@map("stock_items")
}

model StockMovement {
    id             Int          @id @default(autoincrement())
    productId      Int          @map("product_id")
    fromLocationId Int?         @map("from_location_id")
    toLocationId   Int?         @map("to_location_id")
    quantity       Decimal      @db.Decimal(14, 4)
    movementType   MovementType @map("movement_type")
    referenceId    Int?         @map("reference_id")
    referenceType  String?      @map("reference_type")
    notes          String?
    createdById    Int          @map("created_by")
    createdAt      DateTime     @default(now()) @map("created_at")

    product      Product        @relation(fields: [productId], references: [id])
    fromLocation StockLocation? @relation("FromLocation", fields: [fromLocationId], references: [id])
    toLocation   StockLocation? @relation("ToLocation", fields: [toLocationId], references: [id])
    createdBy    User           @relation(fields: [createdById], references: [id])

    @@map("stock_movements")
}

model Supplier {
    id            Int      @id @default(autoincrement())
    name          String
    contactPerson String?  @map("contact_person")
    phone         String?
    email         String?
    address       String?
    tin           String?
    balance       Decimal  @default(0) @db.Decimal(14, 2)
    isActive      Boolean  @default(true) @map("is_active")
    createdAt     DateTime @default(now()) @map("created_at")
    updatedAt     DateTime @updatedAt @map("updated_at")

    purchaseOrders PurchaseOrder[]

    @@map("suppliers")
}

model PurchaseOrder {
    id           Int                 @id @default(autoincrement())
    supplierId   Int                 @map("supplier_id")
    status       PurchaseOrderStatus @default(DRAFT)
    orderedDate  DateTime            @default(now()) @map("ordered_date")
    expectedDate DateTime?           @map("expected_date")
    notes        String?
    createdById  Int                 @map("created_by")
    createdAt    DateTime            @default(now()) @map("created_at")
    updatedAt    DateTime            @updatedAt @map("updated_at")

    supplier      Supplier            @relation(fields: [supplierId], references: [id])
    createdBy     User                @relation(fields: [createdById], references: [id])
    lines         PurchaseOrderLine[]
    goodsReceipts GoodsReceipt[]

    @@map("purchase_orders")
}

model PurchaseOrderLine {
    id              Int     @id @default(autoincrement())
    purchaseOrderId Int     @map("purchase_order_id")
    productId       Int     @map("product_id")
    quantity        Decimal @db.Decimal(14, 4)
    unitPrice       Decimal @map("unit_price") @db.Decimal(14, 2)
    discount        Decimal @default(0) @db.Decimal(14, 2)

    purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
    product       Product       @relation(fields: [productId], references: [id])

    @@map("purchase_order_lines")
}

model GoodsReceipt {
    id              Int      @id @default(autoincrement())
    purchaseOrderId Int?     @map("purchase_order_id")
    receiptDate     DateTime @default(now()) @map("receipt_date")
    notes           String?
    receivedById    Int      @map("received_by")
    createdAt       DateTime @default(now()) @map("created_at")

    purchaseOrder   PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
    receivedBy      User               @relation(fields: [receivedById], references: [id])
    lines           GoodsReceiptLine[]
    supplierInvoice SupplierInvoice?

    @@map("goods_receipts")
}

model GoodsReceiptLine {
    id             Int       @id @default(autoincrement())
    goodsReceiptId Int       @map("goods_receipt_id")
    productId      Int       @map("product_id")
    quantity       Decimal   @db.Decimal(14, 4)
    unitCost       Decimal   @map("unit_cost") @db.Decimal(14, 2)
    expiryDate     DateTime? @map("expiry_date")
    batchNo        String?   @map("batch_no")

    goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id])
    product      Product      @relation(fields: [productId], references: [id])

    @@map("goods_receipt_lines")
}

model SupplierInvoice {
    id             Int      @id @default(autoincrement())
    goodsReceiptId Int      @unique @map("goods_receipt_id")
    invoiceNumber  String   @map("invoice_number")
    invoiceDate    DateTime @map("invoice_date")
    totalAmount    Decimal  @map("total_amount") @db.Decimal(14, 2)
    paidAmount     Decimal  @default(0) @map("paid_amount") @db.Decimal(14, 2)
    balance        Decimal  @db.Decimal(14, 2)
    createdAt      DateTime @default(now()) @map("created_at")
    updatedAt      DateTime @updatedAt @map("updated_at")

    goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id])

    @@map("supplier_invoices")
}

model Customer {
    id          Int      @id @default(autoincrement())
    name        String
    phone       String?
    address     String?
    tin         String?
    creditLimit Decimal  @default(0) @map("credit_limit") @db.Decimal(14, 2)
    balance     Decimal  @default(0) @db.Decimal(14, 2)
    isActive    Boolean  @default(true) @map("is_active")
    createdAt   DateTime @default(now()) @map("created_at")
    updatedAt   DateTime @updatedAt @map("updated_at")

    sales Sale[]

    @@map("customers")
}

model Sale {
    id            Int        @id @default(autoincrement())
    saleNumber    String     @unique @map("sale_number")
    customerId    Int?       @map("customer_id")
    saleType      SaleType   @default(RETAIL) @map("sale_type")
    status        SaleStatus @default(COMPLETED)
    total         Decimal    @db.Decimal(14, 2)
    discountTotal Decimal    @default(0) @map("discount_total") @db.Decimal(14, 2)
    taxTotal      Decimal    @default(0) @map("tax_total") @db.Decimal(14, 2)
    grandTotal    Decimal    @map("grand_total") @db.Decimal(14, 2)
    paidAmount    Decimal    @default(0) @map("paid_amount") @db.Decimal(14, 2)
    balance       Decimal    @default(0) @db.Decimal(14, 2)
    notes         String?
    createdById   Int        @map("created_by")
    createdAt     DateTime   @default(now()) @map("created_at")
    updatedAt     DateTime   @updatedAt @map("updated_at")

    customer      Customer?      @relation(fields: [customerId], references: [id])
    createdBy     User           @relation(fields: [createdById], references: [id])
    lines         SaleLine[]
    payments      Payment[]
    fiscalInvoice InvoiceFiscal?

    @@map("sales")
}

model SaleLine {
    id        Int     @id @default(autoincrement())
    saleId    Int     @map("sale_id")
    productId Int     @map("product_id")
    quantity  Decimal @db.Decimal(14, 4)
    unitPrice Decimal @map("unit_price") @db.Decimal(14, 2)
    discount  Decimal @default(0) @db.Decimal(14, 2)
    lineTotal Decimal @map("line_total") @db.Decimal(14, 2)
    costPrice Decimal @default(0) @map("cost_price") @db.Decimal(14, 2)

    sale    Sale    @relation(fields: [saleId], references: [id])
    product Product @relation(fields: [productId], references: [id])

    @@map("sale_lines")
}

model Payment {
    id               Int           @id @default(autoincrement())
    saleId           Int           @map("sale_id")
    paymentMethod    PaymentMethod @map("payment_method")
    amount           Decimal       @db.Decimal(14, 2)
    paymentReference String?       @map("payment_reference")
    receivedAt       DateTime      @default(now()) @map("received_at")
    receivedById     Int           @map("received_by")

    sale Sale @relation(fields: [saleId], references: [id])

    @@map("payments")
}

model Expense {
    id          Int      @id @default(autoincrement())
    category    String
    description String?
    amount      Decimal  @db.Decimal(14, 2)
    paidTo      String?  @map("paid_to")
    paidById    Int      @map("paid_by")
    paidAt      DateTime @default(now()) @map("paid_at")
    createdAt   DateTime @default(now()) @map("created_at")

    paidBy User @relation(fields: [paidById], references: [id])

    @@map("expenses")
}

model InvoiceFiscal {
    id              Int      @id @default(autoincrement())
    saleId          Int      @unique @map("sale_id")
    efrisUid        String?  @map("efris_uid")
    efrisStatus     String   @default("PENDING") @map("efris_status")
    efrisPayload    Json?    @map("efris_payload")
    responsePayload Json?    @map("response_payload")
    createdAt       DateTime @default(now()) @map("created_at")
    updatedAt       DateTime @updatedAt @map("updated_at")

    sale Sale @relation(fields: [saleId], references: [id])

    @@map("invoice_fiscals")
}

model AuditLog {
    id            Int      @id @default(autoincrement())
    userId        Int?     @map("user_id")
    action        String
    entityType    String   @map("entity_type")
    entityId      Int?     @map("entity_id")
    previousValue Json?    @map("previous_value")
    newValue      Json?    @map("new_value")
    ipAddress     String?  @map("ip_address")
    createdAt     DateTime @default(now()) @map("created_at")

    user User? @relation(fields: [userId], references: [id])

    @@map("audit_logs")
}

enum MovementType {
    PURCHASE
    SALE
    TRANSFER
    ADJUSTMENT
    RETURN_IN
    RETURN_OUT
    DAMAGE
    EXPIRY
}

enum PurchaseOrderStatus {
    DRAFT
    SENT
    PARTIAL
    RECEIVED
    CANCELLED
}

enum SaleType {
    RETAIL
    WHOLESALE
    CREDIT
}

enum SaleStatus {
    PENDING
    COMPLETED
    RETURNED
    VOID
}

enum PaymentMethod {
    CASH
    MOBILE_MONEY
    BANK
    CREDIT
}
