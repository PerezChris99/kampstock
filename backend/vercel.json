{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "ignoreCommand": "git diff HEAD~1 --quiet -- backend/",
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "dist/**,src/generated/**,prisma-pg/schema.prisma,node_modules/.prisma/**,node_modules/@prisma/client/**"
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "api/index.js" }
  ]
}
